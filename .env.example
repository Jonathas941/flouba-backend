# Application
NODE_ENV=development
PORT=8080
APP_VERSION=1.0.0
LOG_LEVEL=info
TRUST_PROXY=false
ENABLE_WEBSOCKET=true
ALLOWED_ORIGINS=http://localhost:3000,https://app.base44.com

# Database
DATABASE_URL=postgresql://flouba:flouba@localhost:5432/flouba_lite?schema=public

# Authentication secrets (generate strong random values — never commit real secrets)
BASE44_API_KEY=change-me-base44-api-key-min-32-chars-long
MT5_ROBOT_API_KEY=change-me-mt5-robot-api-key-min-32-chars
INTERNAL_ADMIN_API_KEY=change-me-internal-admin-api-key-min-32
JWT_SECRET=change-me-jwt-secret-min-32-characters-long!!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BASE44_HMAC_SECRET=change-me-base44-hmac-secret-min-32-chars

# Robot timing
ROBOT_HEARTBEAT_INTERVAL_SECONDS=10
ROBOT_OFFLINE_TIMEOUT_SECONDS=30
COMMAND_POLL_INTERVAL_SECONDS=3
COMMAND_EXPIRATION_SECONDS=300
MAX_COMMAND_RETRY_COUNT=3

# Default risk limits
DEFAULT_MAX_DAILY_LOSS_PERCENT=5
DEFAULT_MAX_DRAWDOWN_PERCENT=10
DEFAULT_MAX_OPEN_POSITIONS=10
DEFAULT_MAX_LOT_SIZE=1.0
DEFAULT_MIN_FREE_MARGIN=100

# Optional operational tuning
REQUEST_TIMESTAMP_TOLERANCE_SECONDS=300
LOG_RETENTION_DAYS=30
API_REQUEST_LOG_RETENTION_DAYS=14
HEARTBEAT_HISTORY_RETENTION_DAYS=7
JOB_INTERVAL_SECONDS=15
RATE_LIMIT_WINDOW_MS=60000
ENABLE_HMAC_VALIDATION=false
RUN_MIGRATIONS=true
